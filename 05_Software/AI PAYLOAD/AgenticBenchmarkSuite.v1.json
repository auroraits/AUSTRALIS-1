      "safety_class": "C_CONTROLLED",
      "args": {"target_type": "NADIR|SUN|GROUND_STATION|RAM", "target_params": "object", "duration_s": "integer", "reason": "string"}
    },
    {
      "name": "gnss.request_fix",
