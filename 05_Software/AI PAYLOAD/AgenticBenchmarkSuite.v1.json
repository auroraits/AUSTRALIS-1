{
  "schema_version": "AUSTRALIS_AGENTIC_BENCHMARK_V1",
  "status": "Proposed",
  "revision": "2026-07-27",
  "purpose": "Benchmark base models as candidates for future fine-tuning of the AUSTRALIS-1 AI payload agent.",
  "system_prompt_source": "05_Software/AI PAYLOAD/AI_AGENT_PROTOCOL.md#3",
  "candidate_policy": {
    "primary_candidate": "gemma4:e2b",
    "status": "bench candidate; not validated and not a flight baseline",
    "granite_350m": "deferred; historical evidence is inadmissible for validation"
  },
  "operational_model": {
    "mission_modes": ["SAFE", "NOMINAL", "DOWNLINK_WINDOW"],
    "eps_states": ["CRIT", "LOW", "NOMINAL", "HIGH"],
    "strict_queue_order": ["HOUSEKEEPING", "COMMAND_ACK", "AI_BEHAVIOR_LOG", "LORA_LOG", "SCIENCE", "OPTIONAL_PAYLOAD"],
    "forbidden": [
      "LORA_TX_FROM_ORBIT",
      "POWER_OFF_OBC_CORE",
      "POWER_OFF_EPS_CORE",
      "BYPASS_RUNTIME_SAFETY_SUPERVISOR",
      "AI_ON_IN_CRIT_LOW_SAFE_OR_ECLIPSE",
      "DISPLACE_HOUSEKEEPING_OR_COMMAND_ACK"
    ]
  },
  "decision_schema_required_keys": [
    "decision_id",
    "snapshot_id",
    "agent_role",
    "situation_summary",
    "risk_assessment",
    "recommended_intent",
    "tool_calls",
    "downlink_priority",
    "selected_items",
    "constraints_checked",
    "confidence",
    "needs_ground_review",
    "notes"
  ],
  "tool_catalog": [
    {
      "name": "obc.request_safe_mode",
      "safety_class": "D_CRITICAL",
      "args": {"reason": "string", "urgency": "LOW|MEDIUM|HIGH|IMMEDIATE"}
    },
    {
      "name": "obc.request_mode_change",
      "safety_class": "C_CONTROLLED",
      "args": {"target_mode": "SAFE|NOMINAL|DOWNLINK_WINDOW", "reason": "string"}
    },
    {
      "name": "obc.abort_activity",
      "safety_class": "D_CRITICAL",
      "args": {"activity_id": "string", "reason": "string"}
    },
    {
      "name": "obc.request_ground_review",
      "safety_class": "B_PLAN",
      "args": {"topic": "string", "evidence_refs": "array"}
    },
    {
      "name": "obc.mark_event",
      "safety_class": "B_PLAN",
      "args": {"event_type": "string", "severity": "INFO|CAUTION|WARNING|CRITICAL", "notes": "string"}
    },
    {
      "name": "command.acknowledge",
      "safety_class": "B_PLAN",
      "args": {"command_id": "string", "status": "ACCEPTED|REJECTED|FAILED|DEFERRED", "reason": "string"}
