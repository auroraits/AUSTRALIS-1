        "reason": "string"
      }
    },
    {
      "name": "eps.shed_loads",
      "safety_class": "D_CRITICAL",
      "args": {"policy": "SURVIVAL|CONSERVE|THERMAL|RF_FAULT", "reason": "string"}
    },
    {
      "name": "downlink.set_queue_policy",
      "safety_class": "C_CONTROLLED",
      "args": {"policy_id": "string", "queue_order": "array", "quotas_bytes": "object"}
    },
    {
      "name": "downlink.select_items",
      "safety_class": "B_PLAN",
      "args": {"queue": "string", "item_ids": "array", "reason": "string"}
    },
    {
      "name": "downlink.schedule_window",
